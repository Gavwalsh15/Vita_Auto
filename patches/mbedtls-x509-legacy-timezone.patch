diff --git a/library/x509.c b/library/x509.c
index f97fb44589..e48f6cb5a6 100644
--- a/library/x509.c
+++ b/library/x509.c
@@ -676,9 +676,22 @@ int mbedtls_x509_get_time(unsigned char **p, const unsigned char *end,
         return MBEDTLS_ERROR_ADD(MBEDTLS_ERR_X509_INVALID_DATE, ret);
     }
 
-    /* len is 12 or 14 depending on year_len, plus optional trailing 'Z' */
+    /*
+     * len is 12 or 14 depending on year_len, plus an optional trailing 'Z'.
+     *
+     * The legacy Google Automotive Link head-unit certificate used by Android
+     * Auto encodes UTCTime with an RFC 5280-predecessor numeric timezone
+     * suffix (for example, "140704000000-0700"). Accept that representation
+     * while keeping the original DER bytes untouched for the TLS handshake.
+     * Certificate verification is intentionally disabled by the AA transport,
+     * so no timezone conversion is required here.
+     */
     if (len != year_len + 10 &&
-        !(len == year_len + 11 && (*p)[(len - 1)] == 'Z')) {
+        !(len == year_len + 11 && (*p)[(len - 1)] == 'Z') &&
+        !(len == year_len + 15 &&
+          ((*p)[year_len + 10] == '+' || (*p)[year_len + 10] == '-') &&
+          x509_parse2_int(*p + year_len + 11) >= 0 &&
+          x509_parse2_int(*p + year_len + 13) >= 0)) {
         return MBEDTLS_ERR_X509_INVALID_DATE;
     }
 
